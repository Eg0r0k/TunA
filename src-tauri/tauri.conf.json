{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tuner",
  "version": "../package.json",
  "identifier": "com.tuner.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tuner",
        "decorations": false,
        "width": 800,
        "minWidth": 400,
        "minHeight": 400,
        "height": 600,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self' mediadevices:; media-src mediadevices: https: 'self'",
      "capabilities": [
        "window-control",
        "media-control",
        "updater"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyMEQ1NzY3RTlDNDA0NzAKUldSd0JNVHBaMWNORW9pYm1hTFNPS3dETnpibGl3OHBMMHlYNEV2RkZrYnh0VEFpUkl3QlA2QksK",
      "endpoints": [
        "https://github.com/Eg0r0k/TunA/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
